# Copy to .env.local for local development, and set the same values in
# Vercel > Settings > Environment Variables for deployments.
#
# Everything here is OPTIONAL. With nothing set, the chat assistant answers
# from the demo knowledge base in src/data/chat.ts and captured leads are
# logged server-side — enough to demo the whole flow, but not to run on.

# ---- Chat assistant -------------------------------------------------
# Set CHAT_API_URL and the live provider replaces the demo answers.
# It POSTs { messages: [{ role, content }] } and reads the reply from
# content / reply / message.content / content[].text — adjust
# src/lib/chat/live-provider.ts if your API differs.
# CHAT_API_URL=https://your-api.example.com/chat
# CHAT_API_KEY=            # sent as: Authorization: Bearer <key>

# ---- Lead capture ---------------------------------------------------
# Where chat-captured leads are delivered. Without this they are only
# logged, which is not durable storage — set it before launch.
# LEADS_WEBHOOK_URL=https://hooks.example.com/formulyn-leads
# LEADS_WEBHOOK_SECRET=    # sent as: Authorization: Bearer <secret>
